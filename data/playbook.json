{
  "version": "1.2.0",
  "categories": {
    "ultimatum": {
      "label": "Ultimatum / Threat",
      "description": "Conditional threats and high-pressure artificial urgencies designed to force compliance through fear of loss, abandonment, or escalation.",
      "severity": "high",
      "color": "#e24b4a",
      "patterns": [
        "if you don't",
        "if you won't",
        "unless you",
        "or else",
        "last chance",
        "final warning",
        "we are done",
        "we're done",
        "i'm done",
        "i am done",
        "it's over",
        "its over",
        "this is your choice",
        "you'll regret",
        "you will regret",
        "don't make me",
        "you're forcing me",
        "you're making me",
        "don't push me",
        "i mean it this time",
        "i swear to god",
        "watch what happens",
        "see what happens",
        "you know what will happen",
        "i won't be responsible",
        "i can't promise",
        "this is your last",
        "either you",
        "you better",
        "you'd better",
        "make up your mind",
        "decide now",
        "answer me",
        "right now",
        "immediately",
        "this ends now",
        "i'll leave",
        "i'm leaving",
        "pack your bags",
        "consequences",
        "consequence",
        "accept the consequences",
        "block them or",
        "choose right now"
      ],
      "regex_patterns": [
        "if you (don'?t|won'?t|refuse to|can'?t comply)",
        "either you (.*) or (else|i will|we are|i'?m)",
        "this is your (last|final) (chance|warning|opportunity)",
        "you (will|'?ll) regret (this|not listening|your choice)",
        "(don'?t|stop) push(ing)? me\\b",
        "(answer|respond to) me (right now|this second|immediately)"
      ]
    },
    "isolation": {
      "label": "Isolation Tactics",
      "description": "Attempts to restrict, monitor, or systematically cut off support networks, including family, best friends, coworkers, or external counselors.",
      "severity": "high",
      "color": "#ef9f27",
      "patterns": [
        "choose between us",
        "choose between me",
        "cut them off",
        "don't talk to them",
        "your friends don't care",
        "why do you need to see",
        "they are a bad influence",
        "they're trying to ruin us",
        "poisoning your mind",
        "filling your head",
        "you don't need anyone",
        "it should just be us",
        "spend too much time with",
        "always whispering",
        "delete their number",
        "block his number",
        "block her number",
        "stop texting him",
        "stop texting her",
        "unfollow them",
        "why are you choosing them",
        "your family is toxic"
      ],
      "regex_patterns": [
        "choose between (me|us) and",
        "stop (talking|texting|seeing|calling) (him|her|them|your)",
        "don'?t need anyone (else|but me|besides us)",
        "(poisoning|filling) your (mind|head)",
        "they (don'?t care about|are trying to ruin|hate) (you|us)"
      ]
    },
    "gaslighting": {
      "label": "Reality Distortion",
      "description": "Systemic attempts to undermine a person's cognitive confidence, memory accuracy, saneness, or baseline environmental perception.",
      "severity": "high",
      "color": "#7f77dd",
      "patterns": [
        "i never said that",
        "you're misremembering",
        "you always blow things",
        "it's all in your head",
        "you're overreacting",
        "you're too sensitive",
        "you're acting crazy",
        "you're crazy",
        "you are insane",
        "making things up",
        "imagining things",
        "i was just joking",
        "can't take a joke",
        "you distort everything",
        "exaggerating",
        "you're paranoid",
        "you need help",
        "get psychiatric help",
        "that never happened",
        "your memory is",
        "you twist my words"
      ],
      "regex_patterns": [
        "i never (said|did|promised) that",
        "you'?re (crazy|insane|misremembering|paranoid|delusional|oversensitive)",
        "making (things|stories|up) again",
        "all in your (head|imagination)",
        "you (always|constantly) twist (everything|my words)"
      ]
    },
    "blame_shift": {
      "label": "Blame Shifting",
      "description": "Deflecting personal accountability onto the targeted individual, framing self-directed actions as inevitable reactions to the victim's behavior.",
      "severity": "medium",
      "color": "#d4537e",
      "patterns": [
        "look what you made me",
        "you made me do this",
        "you forced my hand",
        "if you hadn't",
        "if you just listened",
        "this is your fault",
        "you brought this on",
        "you caused this",
        "i wouldn't have to",
        "you drive me to",
        "because of your behavior",
        "if you didn't act",
        "you always provoke me",
        "you push me to this",
        "always playing the victim",
        "you're the problem",
        "making me out to be",
        "you ruined everything",
        "you brought this out"
      ],
      "regex_patterns": [
        "look what you (made|forced) me (do|say)",
        "if you (hadn'?t|just listened|didn'?t act)",
        "this is (entirely|all) your fault",
        "you (brought this on|caused this to happen|provoked me)"
      ]
    },
    "love_bombing": {
      "label": "Instrumental Affection",
      "description": "Exaggerated declarations of love, sudden overwhelming attachment shifts, or transactional affection deployed strategically to break down healthy personal boundaries or regain lost compliance.",
      "severity": "medium",
      "color": "#1d9e75",
      "patterns": [
        "you are my everything",
        "can't live without you",
        "soulmates",
        "never loved anyone like",
        "nobody will ever love you",
        "we belong together",
        "i will die without you",
        "you're my whole world",
        "perfect match",
        "meant to be",
        "i bought you this",
        "after everything i gave",
        "i do everything for you",
        "sacrificed everything for you",
        "bought you gifts",
        "trying to prove my love",
        "no one else matters"
      ],
      "regex_patterns": [
        "can'?t (live|breathe|survive) without you",
        "nobody (will|could) ever love you (like i do|the way i do)",
        "after (everything|all the things) i'?ve (done|bought|sacrificed) for you",
        "we are (meant to be|soulmates)"
      ]
    },
    "surveillance": {
      "label": "Surveillance / Control",
      "description": "Hyper-vigilant digital tracking, location demands, real-time message monitoring, or aggressive verification requests used to eliminate physical privacy.",
      "severity": "high",
      "color": "#378add",
      "patterns": [
        "where are you",
        "where have you been",
        "who are you with",
        "why aren't you answering",
        "why didn't you answer",
        "you should have answered",
        "i called you",
        "i texted you",
        "give me your password",
        "show me your phone",
        "let me see your messages",
        "you have nothing to hide",
        "if you have nothing to hide",
        "who's that",
        "who was that",
        "why are they texting you",
        "why were you talking to",
        "i need to know where you are",
        "you need to check in",
        "text me when you get there",
        "i track your location",
        "i can see your location",
        "i need access to",
        "share your location",
        "i'll find out anyway",
        "who liked your post",
        "screenshot your screen",
        "send me a photo right now",
        "prove you are where",
        "unlock your phone"
      ],
      "regex_patterns": [
        "where (are you|have you been|who are you with)",
        "why (aren'?t|didn'?t) you (answer|respond|pick up|reply|text back)",
        "(give me|show me|let me see) your (phone|password|messages|location|screen|dm)",
        "you have nothing to hide",
        "(who'?s that|who was that|why are they texting you)"
      ]
    }
  }
}