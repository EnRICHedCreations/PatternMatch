{
  "version": "1.0.0",
  "categories": {
    "ultimatum": {
      "label": "Ultimatum / Threat",
      "description": "Conditional threats designed to force compliance through fear of loss or punishment.",
      "severity": "high",
      "color": "#e24b4a",
      "patterns": [
        "if you don't",
        "if you won't",
        "unless you",
        "or else",
        "last chance",
        "final warning",
        "we are done",
        "we're done",
        "i'm done",
        "i am done",
        "it's over",
        "its over",
        "this is your choice",
        "you'll regret",
        "you will regret",
        "don't make me",
        "you're forcing me",
        "you're making me",
        "don't push me",
        "i mean it this time",
        "i swear to god",
        "watch what happens",
        "see what happens",
        "you know what will happen",
        "i won't be responsible",
        "i can't promise",
        "this is your last",
        "either you",
        "you better",
        "you'd better",
        "make up your mind",
        "decide now",
        "answer me",
        "right now",
        "immediately",
        "this ends now",
        "i'll leave",
        "i'm leaving"
      ],
      "regex_patterns": [
        "\\b(if you (don'?t|won'?t|refuse|keep|stop|start))\\b",
        "\\b(or (else|i will|i'll|we'?re))\\b",
        "\\b(last chance|final (warning|notice|time))\\b",
        "\\b(we'?re|i'?m|it'?s) (over|done|finished|through)\\b",
        "\\byou'?ll (regret|pay for|be sorry)\\b",
        "\\b(don'?t make me|you'?re (forcing|making|pushing) me)\\b",
        "\\b(answer me|right now|decide now)\\b",
        "\\byou (had |have )?better\\b",
        "\\b(either you|you either)\\b"
      ]
    },
    "isolation": {
      "label": "Isolation Tactic",
      "description": "Attempts to separate the target from their support network, creating dependency.",
      "severity": "high",
      "color": "#ef9f27",
      "patterns": [
        "who were you with",
        "who were you talking to",
        "choose between us",
        "choose me or them",
        "your friends don't",
        "your friends aren't",
        "your family doesn't",
        "they don't care",
        "nobody cares like i do",
        "no one loves you like",
        "they don't understand you",
        "we don't need anyone",
        "we don't need them",
        "just the two of us",
        "you don't need them",
        "you don't need anyone",
        "they're a bad influence",
        "they're toxic",
        "stay away from",
        "i don't want you seeing",
        "i don't want you talking to",
        "why do you need to",
        "why do you always need",
        "you're always with them",
        "why can't it just be us",
        "they're turning you against me",
        "they don't have your best interests",
        "only i know what's best",
        "i know you better than",
        "they're using you",
        "everyone else has an agenda"
      ],
      "regex_patterns": [
        "\\b(choose between (us|me|them))\\b",
        "\\byour (friends?|family|sister|brother|mom|dad|mother|father|coworkers?|colleagues?)\\b.{0,40}\\b(don'?t|never|aren'?t|won'?t|can'?t|doesn'?t)\\b",
        "\\b(nobody|no one) (cares?|loves?|understands?|knows?) (you )?(like|as much as) (i|me)\\b",
        "\\bwe don'?t need (anyone|them|anyone else|each other)\\b",
        "\\b(just (the two of )?us|only us)\\b",
        "\\byou don'?t need (them|anyone|friends|family)\\b",
        "\\b(stay away from|i don'?t want you (seeing|talking to|spending time with))\\b",
        "\\b(why do you (always )?need to|why can'?t it just be us)\\b",
        "\\bthey'?re (turning you|using you|against me|toxic|a bad influence)\\b"
      ]
    },
    "gaslighting": {
      "label": "Reality Distortion",
      "description": "Manipulating someone into questioning their own memory, perception, and sanity.",
      "severity": "high",
      "color": "#7f77dd",
      "patterns": [
        "you're crazy",
        "you're insane",
        "you're paranoid",
        "you're delusional",
        "you're overreacting",
        "you're too sensitive",
        "you're imagining things",
        "you imagined it",
        "i never said that",
        "i never did that",
        "that never happened",
        "you're misremembering",
        "you always blow things",
        "out of proportion",
        "everyone thinks you",
        "everyone agrees",
        "everyone says",
        "you're the only one",
        "no one else has a problem",
        "you make everything up",
        "you always twist",
        "you twist my words",
        "you're twisting things",
        "you always exaggerate",
        "stop exaggerating",
        "you heard wrong",
        "that's not what i said",
        "that's not what i meant",
        "you took it out of context",
        "you always do this",
        "here we go again",
        "you're making me look bad",
        "you always make me out to be",
        "i don't know what you're talking about",
        "you need help",
        "maybe you should see someone",
        "you're being irrational",
        "you're not thinking clearly",
        "calm down, you're hysterical"
      ],
      "regex_patterns": [
        "\\byou'?re (crazy|insane|paranoid|delusional|overreacting|irrational|hysterical|too sensitive)\\b",
        "\\b(i never (said|did|meant|told))\\b",
        "\\bthat never happened\\b",
        "\\byou'?re (mis)?remembering (it |that )?(wrong|incorrectly)?\\b",
        "\\b(blow(ing)? (things|it|everything) out of proportion)\\b",
        "\\b(everyone (else )?(thinks|says|agrees|knows|believes))\\b",
        "\\byou (always )?(twist|exaggerate|make up|imagine|imagined)\\b",
        "\\bthat'?s not what i (said|meant)\\b",
        "\\byou took it out of context\\b",
        "\\b(here we go again|you always do this)\\b",
        "\\byou'?re (not thinking clearly|being irrational|making things up)\\b"
      ]
    },
    "blame_shift": {
      "label": "Blame Shifting",
      "description": "Deflecting responsibility onto the victim, making them feel at fault for the abuser's behavior.",
      "severity": "high",
      "color": "#d4537e",
      "patterns": [
        "you always mess up",
        "you always ruin",
        "you always cause",
        "you always start",
        "you never think",
        "you never care",
        "you never listen",
        "you never try",
        "because of you",
        "you made me do",
        "you make me do",
        "you caused this",
        "you started this",
        "this is your fault",
        "you brought this on yourself",
        "this is on you",
        "i have to fix everything",
        "i always have to clean up",
        "you force my hand",
        "you push me to",
        "you push my buttons",
        "you know what you do",
        "you know how you are",
        "look what you made me do",
        "you did this to us",
        "everything was fine until you",
        "i wouldn't have to if you",
        "i only did it because you",
        "if you hadn't",
        "you left me no choice",
        "see what you made me do",
        "you bring out the worst"
      ],
      "regex_patterns": [
        "\\byou (always|never) (mess(es)?( up)?|ruin(s)?|cause[sd]?|start(s|ed)?|think(s)?|care[sd]?|listen(s|ed)?|tr(y|ies|ied))\\b",
        "\\b(because of you|your fault|on you)\\b",
        "\\byou (made|make|caused|cause|forced|force) me\\b",
        "\\b(this is (all )?your fault|you (brought|caused|started) this)\\b",
        "\\b(i have to (fix|handle|deal with|clean up) everything)\\b",
        "\\byou (push|force|drive) me (to|into|over)\\b",
        "\\b(look what you (made|did)|see what you (made|did))\\b",
        "\\b(i (only|just) did it because you|i wouldn'?t have (to|done) (it )?if you)\\b",
        "\\byou left me no choice\\b",
        "\\byou bring out the worst\\b"
      ]
    },
    "love_bombing": {
      "label": "Love Bombing / Manipulation",
      "description": "Excessive flattery or affection used instrumentally to gain compliance or after an abusive episode.",
      "severity": "medium",
      "color": "#5dcaa5",
      "patterns": [
        "you're the only one who",
        "no one will ever love you like",
        "i love you more than anything",
        "you complete me",
        "i can't live without you",
        "you're my everything",
        "i'd die without you",
        "i'll do anything for you",
        "i'll change, i promise",
        "i'll never do it again",
        "you know i love you",
        "but i love you",
        "i love you so much that",
        "if you loved me you would",
        "if you really loved me",
        "prove you love me",
        "show me you love me",
        "real love means",
        "that's not what love is",
        "you don't know how to love"
      ],
      "regex_patterns": [
        "\\bno (one|person) will ever love you like\\b",
        "\\bi (can'?t live|'?d die) without you\\b",
        "\\bi'?ll (change|never do it again|be different)\\b",
        "\\bif you (really |truly )?(loved|cared about) me (you would|you'd)\\b",
        "\\b(prove|show) (you love me|me you care|me you love me)\\b",
        "\\byou'?re (my everything|the only one|my whole world)\\b"
      ]
    },
    "surveillance": {
      "label": "Surveillance / Control",
      "description": "Monitoring, tracking, or demanding access as a means of control.",
      "severity": "high",
      "color": "#378add",
      "patterns": [
        "where are you",
        "where have you been",
        "who are you with",
        "why aren't you answering",
        "why didn't you answer",
        "you should have answered",
        "i called you",
        "i texted you",
        "give me your password",
        "show me your phone",
        "let me see your messages",
        "you have nothing to hide",
        "if you have nothing to hide",
        "who's that",
        "who was that",
        "why are they texting you",
        "why were you talking to",
        "i need to know where you are",
        "you need to check in",
        "text me when you get there",
        "i track your location",
        "i can see your location",
        "i need access to",
        "share your location",
        "i'll find out anyway"
      ],
      "regex_patterns": [
        "\\b(where are you|where have you been|who are you with)\\b",
        "\\bwhy (aren'?t|didn'?t) you (answer|respond|pick up|reply)\\b",
        "\\b(give me|show me) your (phone|password|messages|location)\\b",
        "\\byou have nothing to hide\\b",
        "\\b(who'?s that|who was that|why are they|why were you)\\b",
        "\\b(check in|share your location|i('?ll| can) (track|see|find) your)\\b",
        "\\bi'?ll find out anyway\\b"
      ]
    }
  }
}
